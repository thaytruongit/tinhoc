# ==============================================================================
# CLOUDPLAY LEARNING OS — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Gemini AI Engine Key (Required for AI Studio, OCR Scanner, Fast-Finisher & Scaffolding)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application Public Hosting URL
APP_URL="MY_APP_URL"

# Supabase Client Realtime & REST Configuration (Frontend & Backend Sync)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# Supabase / PostgreSQL Connection String (Option A - Direct URL / Connection Pooler)
DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
SUPABASE_DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@aws-0-asia-southeast1.pooler.supabase.com:6543/postgres"

# Supabase / Cloud SQL PostgreSQL Connection Parameters (Option B - Individual Host Fields)
SQL_HOST="db.[YOUR-PROJECT-REF].supabase.co"
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER="postgres"
SQL_PASSWORD="YOUR_SUPABASE_DB_PASSWORD"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="YOUR_SUPABASE_DB_PASSWORD"

# Automated 24/7 Keep-Alive Cron Secret (Anti-Hibernation for Supabase Free Tier)
CRON_SECRET="cloudplay_keep_alive_secret_2026"

