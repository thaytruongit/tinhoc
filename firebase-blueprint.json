{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator marker document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the admin."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["uid", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public student or teacher learning profile without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the student or teacher."
        },
        "studentCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "School student code or teacher code."
        },
        "classId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Classroom identifier (e.g. 6A10, 10A1)."
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher"],
          "description": "User role within the learning platform."
        },
        "xp": {
          "type": "integer",
          "description": "Total accumulated experience points."
        },
        "streakDays": {
          "type": "integer",
          "description": "Consecutive learning streak days."
        },
        "stars": {
          "type": "integer",
          "description": "Total stars earned."
        },
        "groupNumber": {
          "type": "integer",
          "description": "Classroom team/group number (1-4)."
        },
        "partnerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Paired study companion name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "studentCode",
        "classId",
        "role",
        "xp",
        "streakDays",
        "stars",
        "groupNumber",
        "partnerName",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorksheetSubmission": {
      "title": "WorksheetSubmission",
      "description": "Interactive electronic worksheet or project submission by a student.",
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique submission document ID."
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the submitting student."
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the student."
        },
        "studentCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Student code (e.g. 61008)."
        },
        "classId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Class ID (e.g. 6A10)."
        },
        "lessonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated lesson ID."
        },
        "stageId": {
          "type": "integer",
          "description": "Pedagogical stage number (1 to 4)."
        },
        "score": {
          "type": "number",
          "description": "Earned score (0 to 10)."
        },
        "maxScore": {
          "type": "number",
          "description": "Maximum possible score (10)."
        },
        "status": {
          "type": "string",
          "enum": ["in_progress", "submitted", "graded"],
          "description": "Lifecycle status of the worksheet."
        },
        "answersSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Serialized summary of student answers."
        },
        "teacherFeedback": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "description": "Feedback provided by teacher or rubric."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": [
        "submissionId",
        "studentUid",
        "studentName",
        "studentCode",
        "classId",
        "lessonId",
        "stageId",
        "score",
        "maxScore",
        "status",
        "answersSummary",
        "teacherFeedback",
        "createdAt",
        "updatedAt"
      ]
    },
    "LessonConfig": {
      "title": "LessonConfig",
      "description": "Digital lesson configuration authored by teacher.",
      "type": "object",
      "properties": {
        "lessonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Lesson identifier."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Teacher author UID."
        },
        "classId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target class ID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Lesson title."
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Curriculum topic."
        },
        "activeStage": {
          "type": "integer",
          "description": "Currently active pedagogical stage (1-4)."
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "archived"],
          "description": "Publication status."
        },
        "videoUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Interactive video URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": [
        "lessonId",
        "authorUid",
        "classId",
        "title",
        "topic",
        "activeStage",
        "status",
        "videoUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "WordCloudEntry": {
      "title": "WordCloudEntry",
      "description": "Real-time ice-breaker word cloud entry submitted by a student.",
      "type": "object",
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Entry document ID."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Student author UID."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Student display name."
        },
        "classId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Class ID."
        },
        "lessonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Lesson ID."
        },
        "word": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Submitted keyword or short phrase."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp."
        }
      },
      "required": [
        "entryId",
        "authorUid",
        "authorName",
        "classId",
        "lessonId",
        "word",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Read-only admin registry collection."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public learning profiles without PII."
    },
    "/worksheets/{submissionId}": {
      "schema": { "$ref": "#/entities/WorksheetSubmission" },
      "description": "Interactive worksheet and project submissions."
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/LessonConfig" },
      "description": "Digital lessons and 4-stage configurations."
    },
    "/wordCloudEntries/{entryId}": {
      "schema": { "$ref": "#/entities/WordCloudEntry" },
      "description": "Real-time word cloud entries for classroom ice-breakers."
    }
  }
}
